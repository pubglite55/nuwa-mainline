#!/bin/busybox sh
# nuwa 自包含 initramfs：所有输出同时到屏幕(tty0)与内核日志
/bin/busybox mount -t proc proc /proc 2>/dev/null
/bin/busybox mount -t sysfs sysfs /sys 2>/dev/null
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null
/bin/busybox mkdir -p /dev/pts /dev/shm /tmp /run /sys/kernel/config
/bin/busybox mount -t devpts devpts /dev/pts 2>/dev/null
/bin/busybox mount -t configfs none /sys/kernel/config 2>/dev/null

# 关键：把后续所有输出打到可见设备（按可用性兜底）
for OUT in /dev/tty0 /dev/console /dev/ttyAMA0; do
  if [ -c "$OUT" ] || [ -e "$OUT" ]; then
    exec >"$OUT" 2>&1
    break
  fi
done
# 兜底：同时把关键信息写进内核日志（即使屏幕不可用也能从 pstore/dmesg 取）
echo "nuwa-init: output bound" > /dev/kmsg 2>/dev/null || true

echo ""
echo "=============================================="
echo "  nuwa initramfs  |  mainline kernel + UEFI"
echo "=============================================="
echo "uptime : $(/bin/busybox cat /proc/uptime 2>/dev/null)"
echo "cmdline: $(/bin/busybox cat /proc/cmdline 2>/dev/null)"
echo "kernel : $(/bin/busybox uname -r 2>/dev/null)"
echo ""

echo "-- 加载驱动模块 --"
for m in /lib/modules/*.ko; do
  [ -f "$m" ] || continue
  /bin/busybox insmod "$m" 2>/dev/null && echo "   ok  $(/bin/busybox basename "$m")"
done
for m in /lib/modules/*.ko; do
  [ -f "$m" ] || continue
  /bin/busybox insmod "$m" 2>/dev/null
done
echo ""

echo "-- 显示与输入设备 --"
for d in /sys/class/drm /sys/class/graphics /sys/class/input; do
  echo "   $d: $(/bin/busybox ls $d 2>/dev/null | /bin/busybox tr '\n' ' ')"
done
echo ""

echo "-- USB gadget (NCM) --"
G=/sys/kernel/config/usb_gadget/nuwa
if [ -d /sys/kernel/config/usb_gadget ]; then
  /bin/busybox mkdir -p $G
  echo 0x1d6b > $G/idVendor 2>/dev/null
  echo 0x0104 > $G/idProduct 2>/dev/null
  /bin/busybox mkdir -p $G/strings/0x409
  echo nuwa > $G/strings/0x409/serialnumber 2>/dev/null
  echo nuwa > $G/strings/0x409/manufacturer 2>/dev/null
  echo nuwa > $G/strings/0x409/product 2>/dev/null
  /bin/busybox mkdir -p $G/configs/c.1/strings/0x409
  echo ncm > $G/configs/c.1/strings/0x409/configuration 2>/dev/null
  /bin/busybox mkdir -p $G/functions/ncm.usb0 2>/dev/null
  /bin/busybox ln -sf $G/functions/ncm.usb0 $G/configs/c.1/ncm.usb0 2>/dev/null
  UDC=$(/bin/busybox ls /sys/class/udc 2>/dev/null | /bin/busybox head -1)
  echo "   udc: ${UDC:-<none>}"
  [ -n "$UDC" ] && echo "$UDC" > $G/UDC 2>/dev/null
else
  echo "   configfs 不可用"
fi

/bin/busybox sleep 2
/bin/busybox ip link set usb0 up 2>/dev/null
/bin/busybox ip addr add 192.168.0.1/24 dev usb0 2>/dev/null
echo "   usb0: $(/bin/busybox ip -4 addr show usb0 2>/dev/null | /bin/busybox grep inet)"
/bin/busybox telnetd -l /bin/sh -p 23 2>/dev/null && echo "   telnetd 已启动 (192.168.0.1:23)"
echo ""

echo "-- 网络接口 --"
/bin/busybox ip -4 addr show 2>/dev/null | /bin/busybox grep -E "^[0-9]|inet"
echo ""
echo "=== 系统就绪：可 telnet 192.168.0.1 ==="
echo "=== 120 秒后自动重启 ==="
echo ""

/bin/busybox sleep 120
/bin/busybox reboot -f
