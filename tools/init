#!/bin/busybox sh
# nuwa 自包含 initramfs：所有输出同时到屏幕(tty0)与内核日志
/bin/busybox mount -t proc proc /proc 2>/dev/null
/bin/busybox mount -t sysfs sysfs /sys 2>/dev/null
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null
/bin/busybox mkdir -p /dev/pts /dev/shm /tmp /run /sys/kernel/config
/bin/busybox mount -t devpts devpts /dev/pts 2>/dev/null
/bin/busybox mount -t configfs none /sys/kernel/config 2>/dev/null

# 关键：所有输出走内核日志（/dev/kmsg）
# 这样 console=tty0 时屏幕上能看到，同时 dmesg/pstore 也有记录，
# 不会因为 /dev/tty0 或 /dev/console 打不开而全部丢失。
if [ -w /dev/kmsg ]; then
  exec >/dev/kmsg 2>&1
  echo "nuwa-init: bound to /dev/kmsg"
else
  for OUT in /dev/tty0 /dev/console /dev/ttyAMA0; do
    if [ -e "$OUT" ]; then exec >"$OUT" 2>&1; break; fi
  done
  echo "nuwa-init: bound to fallback"
fi

echo "-- busybox applet 自检 --"
for a in ip ifconfig telnetd insmod mount mkdir ln sh cat sleep; do
  if /bin/busybox --list 2>/dev/null | /bin/busybox grep -qx "$a"; then
    echo "   OK   $a"
  else
    echo "   MISS $a"
  fi
done
echo ""
echo "=============================================="
echo "  nuwa initramfs  |  mainline kernel + UEFI"
echo "=============================================="
echo "uptime : $(/bin/busybox cat /proc/uptime 2>/dev/null)"
echo "cmdline: $(/bin/busybox cat /proc/cmdline 2>/dev/null)"
echo "kernel : $(/bin/busybox uname -r 2>/dev/null)"
echo ""

echo "-- 加载驱动模块 --"
for m in /lib/modules/*.ko; do
  [ -f "$m" ] || continue
  /bin/busybox insmod "$m" 2>/dev/null && echo "   ok  $(/bin/busybox basename "$m")"
done
for m in /lib/modules/*.ko; do
  [ -f "$m" ] || continue
  /bin/busybox insmod "$m" 2>/dev/null
done
echo ""

echo "-- 显示与输入设备 --"
for d in /sys/class/drm /sys/class/graphics /sys/class/input; do
  echo "   $d: $(/bin/busybox ls $d 2>/dev/null | /bin/busybox tr '\n' ' ')"
done
echo ""

echo "-- USB gadget (NCM) --"
G=/sys/kernel/config/usb_gadget/nuwa
if [ -d /sys/kernel/config/usb_gadget ]; then
  /bin/busybox mkdir -p $G 2>/dev/null
  echo 0x0200 > $G/bcdUSB 2>/dev/null
  echo 0x0100 > $G/bcdDevice 2>/dev/null
  echo 0x1d6b > $G/idVendor 2>/dev/null
  echo 0x0104 > $G/idProduct 2>/dev/null
  /bin/busybox mkdir -p $G/strings/0x409 2>/dev/null
  echo 3705933 > $G/strings/0x409/serialnumber 2>/dev/null
  echo nuwa > $G/strings/0x409/manufacturer 2>/dev/null
  echo "nuwa mainline" > $G/strings/0x409/product 2>/dev/null
  /bin/busybox mkdir -p $G/configs/c.1/strings/0x409 2>/dev/null
  echo ncm > $G/configs/c.1/strings/0x409/configuration 2>/dev/null
  echo 250 > $G/configs/c.1/MaxPower 2>/dev/null
  /bin/busybox mkdir -p $G/functions/ncm.usb0 2>/dev/null
  /bin/busybox ln -sf $G/functions/ncm.usb0 $G/configs/c.1/ncm.usb0 2>/dev/null

  UDC=$(/bin/busybox ls /sys/class/udc 2>/dev/null | /bin/busybox head -1)
  echo "   udc: ${UDC:-<none>}"
  if [ -n "$UDC" ]; then
    echo "$UDC" > $G/UDC 2>/dev/null
    echo "   bound: $(/bin/busybox cat $G/UDC 2>/dev/null)"
  else
    echo "   !! 没有 UDC（dwc3 未绑定）"
    echo "   !! dwc3 相关 dmesg："
    /bin/busybox dmesg 2>/dev/null | /bin/busybox grep -iE "dwc3|udc|phy.*usb" | /bin/busybox tail -8
  fi
else
  echo "   configfs 不可用"
fi

# 等 usb0 出现（最多 10 秒），不要用固定 sleep
i=0
while [ $i -lt 20 ]; do
  if [ -e /sys/class/net/usb0 ]; then break; fi
  /bin/busybox sleep 0.5
  i=$((i+1))
done
if [ -e /sys/class/net/usb0 ]; then
  if /bin/busybox ip link set usb0 up 2>/dev/null && /bin/busybox ip addr add 192.168.0.1/24 dev usb0 2>/dev/null; then
    echo "   usb0 配置完成 (ip)"
  elif /bin/busybox ifconfig usb0 192.168.0.1 netmask 255.255.255.0 up 2>/dev/null; then
    echo "   usb0 配置完成 (ifconfig 兜底)"
  else
    echo "   !! usb0 配置失败（ip 与 ifconfig 都不可用）"
  fi
  echo "   usb0 状态: $(/bin/busybox ip -4 addr show usb0 2>/dev/null | /bin/busybox grep inet || /bin/busybox ifconfig usb0 2>/dev/null | /bin/busybox grep -i 'inet addr' || echo '<未知>')"
else
  echo "   !! usb0 未出现（等待 10 秒超时）"
fi
/bin/busybox telnetd -l /bin/sh -p 23 2>/dev/null && echo "   telnetd 已启动 (192.168.0.1:23)" || echo "   !! telnetd 启动失败"
echo ""

echo "-- 网络接口 --"
if /bin/busybox ip -4 addr show 2>&1 | /bin/busybox grep -E "^[0-9]|inet"; then :; else echo "   !! ip 命令不可用或无网卡"; fi
echo ""
echo "=== 系统就绪：可 telnet 192.168.0.1 ==="
echo "=== 120 秒后自动重启 ==="
echo ""

/bin/busybox sleep 120
/bin/busybox reboot -f
